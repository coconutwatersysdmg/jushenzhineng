/* Light Material overlay — bright panels on top of qt-material light_pink. */

QMainWindow, QDialog {
    background-color: #f5f5f5;
    color: #2b2b2b;
}

QWidget#centralRoot {
    background-color: #f5f5f5;
    color: #2b2b2b;
    font-size: 12px;
}

QFrame#topBar {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
}

QFrame#deviceStrip {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
}

QFrame#card {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
}

QFrame#camUnit {
    background-color: #fafafa;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
}

QFrame#camUnit QLabel {
    background: transparent;
    border: none;
    border-bottom: 1px solid #ececec;
    color: #555555;
    padding: 8px 10px;
}

QFrame#camUnit QComboBox {
    border: none;
    border-bottom: 1px solid #ececec;
    border-radius: 0;
    background-color: #ffffff;
}

QFrame#camUnit QTableWidget {
    background: transparent;
    border: none;
    border-radius: 0;
}

QLabel#title {
    font-size: 22px;
    font-weight: 700;
    color: #212121;
    letter-spacing: 0.4px;
}

QLabel#sectionTitle {
    font-size: 13px;
    font-weight: 700;
    color: #ff4081;
}

QLabel#mutedLabel {
    color: #666666;
    font-weight: 600;
}

QLabel#phaseLabel {
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    padding: 4px 10px;
    background-color: #ff4081;
    border-radius: 4px;
}

QLabel#progressLabel {
    font-size: 15px;
    font-weight: 700;
    color: #ff4081;
    padding: 4px 10px;
    background-color: #ffe4ef;
    border: 1px solid #ff79b0;
    border-radius: 4px;
}

QLabel#mutedArrow {
    color: #bdbdbd;
    font-size: 16px;
}

QLabel#mediaWell, QLabel#historyPreview {
    background-color: #fafafa;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    color: #757575;
}

QLabel#emptyState {
    color: #757575;
    font-size: 14px;
    background-color: #fafafa;
    border: 1px dashed #ff79b0;
    border-radius: 8px;
    padding: 24px;
}

QLabel#moduleBanner {
    color: #212121;
    font-size: 13px;
    font-weight: 700;
    background-color: #ffe4ef;
    border: 1px solid #ff79b0;
    border-radius: 5px;
    padding: 6px 8px;
}

QLabel#accentInfo {
    color: #c2185b;
    font-weight: 600;
}

QLabel#successInfo {
    color: #2e7d32;
}

QPushButton#primary {
    background-color: #ff4081;
    border: 1px solid #ff4081;
    color: #ffffff;
    font-weight: 700;
    border-radius: 4px;
    padding: 7px 14px;
}

QPushButton#primary:hover {
    background-color: #f50057;
    border-color: #f50057;
}

QPushButton#primary:pressed {
    background-color: #c51162;
}

QTabBar::tab:selected {
    color: #ff4081;
    font-weight: 700;
}
